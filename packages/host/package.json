{
  "name": "dsh-workbench-host",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "description": "个人工作台宿主：本地 SQLite、业务域注册、HTTP/SSE、Workbench agent 工具、账号与数据同步。",
  "license": "MIT",
  "author": "ityyq777",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbench",
    "sqlite",
    "sync",
    "tasks",
    "sites",
    "tags"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityyq777/dsh-workbench.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/ityyq777/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ityyq777/dsh-workbench/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
