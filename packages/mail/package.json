{
  "name": "dsh-workbench-mail",
  "version": "0.6.2",
  "description": "个人工作台邮件插件：安全 IMAP 收信、文件夹与已读同步、附件按需下载、草稿与 SMTP 回复转发",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-mail",
      "title": "邮件",
      "version": "0.6.2",
      "minShell": "0.8.4",
      "tables": [
        "mail_account",
        "mail_mailbox",
        "mail_message",
        "mail_attachment"
      ],
      "views": [
        "messages",
        "compose",
        "accounts",
        "data",
        "actions"
      ],
      "toolActions": [
        "mail.status",
        "mail.accountList",
        "mail.accountCreate",
        "mail.accountUpdate",
        "mail.accountDelete",
        "mail.accountTest",
        "mail.mailboxList",
        "mail.mailboxSync",
        "mail.messageList",
        "mail.messageGet",
        "mail.messageBody",
        "mail.messageSend",
        "mail.messageMarkRead",
        "mail.messageMove",
        "mail.messageDelete",
        "mail.sync",
        "mail.dataTables",
        "mail.dataQuery",
        "mail.providerList",
        "mail.accountProbe",
        "mail.attachmentDownload",
        "mail.draftGet",
        "mail.draftList",
        "mail.draftSave",
        "mail.draftDelete",
        "mail.actionSchema"
      ],
      "client": "lib/client.js"
    }
  },
  "dependencies": {
    "dsh-workbench-vault": "^0.4.4",
    "dsh-workbench-host": "^0.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-workbench-host"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "author": "ityyq777",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mail",
    "imap",
    "smtp",
    "email"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityyq777/dsh-workbench.git",
    "directory": "packages/mail"
  },
  "homepage": "https://github.com/ityyq777/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ityyq777/dsh-workbench/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
