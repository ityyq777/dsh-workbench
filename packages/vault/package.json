{
  "name": "dsh-workbench-vault",
  "version": "0.4.3",
  "description": "个人工作台凭据保险箱：加密保存密码与 token，agent 只见掩码",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-vault",
      "title": "凭据保险箱",
      "version": "0.4.3",
      "minShell": "0.8.0",
      "tables": [
        "vault_header",
        "vault_device",
        "vault_group",
        "vault_secret",
        "vault_binding",
        "vault_subject_type",
        "vault_secret_usage"
      ],
      "views": [
        "status",
        "secrets",
        "groups",
        "config",
        "data",
        "actions"
      ],
      "toolActions": [
        "vault.status",
        "vault.setup",
        "vault.unlock",
        "vault.lock",
        "vault.setUnlockMode",
        "vault.changePassphrase",
        "vault.secretList",
        "vault.secretCreate",
        "vault.secretUpdate",
        "vault.secretDelete",
        "vault.secretReveal",
        "vault.rotateDeviceKey",
        "vault.dataTables",
        "vault.dataQuery",
        "vault.actionSchema",
        "vault.groupList",
        "vault.groupCreate",
        "vault.groupUpdate",
        "vault.groupDelete",
        "vault.subjectRegister",
        "vault.bind",
        "vault.unbind",
        "vault.bindingsOf",
        "vault.subjectsOf",
        "vault.subjectSecrets",
        "vault.bindingPurge",
        "vault.syncStatus"
      ],
      "client": "lib/client.js"
    }
  },
  "dependencies": {
    "dsh-workbench-host": "^0.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-workbench-host"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "author": "ityyq777",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vault",
    "secrets",
    "password",
    "token",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityyq777/dsh-workbench.git",
    "directory": "packages/vault"
  },
  "homepage": "https://github.com/ityyq777/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ityyq777/dsh-workbench/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
