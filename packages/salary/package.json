{
  "name": "dsh-workbench-salary",
  "version": "0.4.5",
  "description": "个人工作台工资插件：按发薪日期记录工资构成、扣款与实发",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-salary",
      "title": "工资",
      "version": "0.4.5",
      "minShell": "0.8.0",
      "tables": [
        "salary_record"
      ],
      "views": [
        "records",
        "stats",
        "data",
        "actions"
      ],
      "toolActions": [
        "salary.status",
        "salary.stats",
        "salary.recordList",
        "salary.recordGet",
        "salary.recordCreate",
        "salary.recordUpdate",
        "salary.recordDelete",
        "salary.dataTables",
        "salary.dataQuery",
        "salary.actionSchema"
      ],
      "client": "lib/client.js"
    }
  },
  "dependencies": {
    "dsh-workbench-host": "^0.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-workbench-host"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "author": "ityyq777",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "salary",
    "payroll",
    "wage",
    "income"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityyq777/dsh-workbench.git",
    "directory": "packages/salary"
  },
  "homepage": "https://github.com/ityyq777/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ityyq777/dsh-workbench/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
