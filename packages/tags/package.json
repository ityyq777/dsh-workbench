{
  "name": "dsh-workbench-tags",
  "version": "1.7.0",
  "description": "个人工作台标签插件：创建与管理标签，为站点等业务提供标签归类",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "wb": {
    "addon": {
      "id": "wb-addon-tags",
      "title": "标签",
      "description": "标签 + 统计/记录/配置/数据四个视图：创建与管理标签，为站点等业务提供标签归类，附表数据浏览",
      "version": "1.7.0",
      "minShell": "0.5.0",
      "tables": [
        "tag",
        "tag_mapping"
      ],
      "views": [
        "stats",
        "tags",
        "config",
        "data"
      ],
      "toolActions": [
        "tags.list",
        "tags.search",
        "tags.create",
        "tags.delete",
        "tags.byIds",
        "tags.link",
        "tags.unlink",
        "tags.itemsOf",
        "tags.stats",
        "tags.statsReport",
        "tags.configGet",
        "tags.configSet",
        "tags.configReset",
        "tags.configOptions",
        "tags.dataTables",
        "tags.dataQuery"
      ],
      "client": "lib/client.js"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-workbench-host": "^0.6.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workbench-host"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "license": "MIT",
  "author": "ityyq777",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tags",
    "label",
    "catalog"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityyq777/dsh-workbench.git",
    "directory": "packages/tags"
  },
  "homepage": "https://github.com/ityyq777/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ityyq777/dsh-workbench/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
