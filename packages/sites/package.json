{
  "name": "dsh-workbench-sites",
  "version": "1.0.3",
  "type": "module",
  "description": "个人工作台站点插件：目录树、链接与标签",
  "main": "lib/index.js",
  "wb": {
    "addon": {
      "id": "wb-addon-sites",
      "title": "站点",
      "description": "站点收藏：目录树、链接与标签",
      "version": "1.0.3",
      "minShell": "0.2.0",
      "tables": [
        "site",
        "site_node",
        "site_node_mapping"
      ],
      "views": [
        "sites"
      ],
      "toolActions": [
        "sites.capabilities",
        "sites.list",
        "sites.get",
        "sites.create",
        "sites.update",
        "sites.delete",
        "sites.stats",
        "siteTags.search",
        "siteTags.byIds",
        "siteNodes.tree",
        "siteNodes.children",
        "siteNodes.multipleChildren",
        "siteNodes.pathChildren",
        "siteNodes.path",
        "siteNodes.create",
        "siteNodes.rename",
        "siteNodes.move",
        "siteNodes.delete"
      ],
      "client": "lib/client.js"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-workbench-host": "^0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workbench-host"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "ityyq777",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sites",
    "bookmarks",
    "links",
    "tree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityyq777/dsh-workbench.git",
    "directory": "packages/sites"
  },
  "homepage": "https://github.com/ityyq777/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ityyq777/dsh-workbench/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
