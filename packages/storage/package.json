{
  "name": "dsh-workbench-storage",
  "version": "1.5.1",
  "type": "module",
  "description": "个人工作台储物插件：名称、品牌、单位、库存文本与标签",
  "main": "lib/index.js",
  "wb": {
    "addon": {
      "id": "wb-addon-storage",
      "title": "储物",
      "description": "储物：统计/记录/配置/数据四个视图",
      "version": "1.5.1",
      "minShell": "0.5.7",
      "tables": [
        "storage"
      ],
      "views": [
        "stats",
        "storage",
        "config",
        "data"
      ],
      "toolActions": [
        "storage.capabilities",
        "storage.list",
        "storage.get",
        "storage.create",
        "storage.update",
        "storage.delete",
        "storage.bulkDelete",
        "storage.stats",
        "storageTags.search",
        "storageTags.byIds",
        "storage.configGet",
        "storage.configSet",
        "storage.configReset",
        "storage.configOptions",
        "storage.dataTables",
        "storage.dataQuery"
      ],
      "client": "lib/client.js"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-workbench-host": "^0.6.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workbench-host"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "ityyq777",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "storage",
    "inventory",
    "items",
    "tags"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityyq777/dsh-workbench.git",
    "directory": "packages/storage"
  },
  "homepage": "https://github.com/ityyq777/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ityyq777/dsh-workbench/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
