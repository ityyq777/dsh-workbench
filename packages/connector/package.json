{
  "name": "dsh-workbench-connector",
  "version": "0.1.2",
  "description": "个人工作台连接器插件：RSS/Webhook 内容接入，来源定义、条目与运行记录",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-connector",
      "title": "连接器",
      "version": "0.1.2",
      "minShell": "0.6.7",
      "tables": [
        "connector_source",
        "connector_source_state",
        "connector_item",
        "connector_run"
      ],
      "views": [
        "stats",
        "sources",
        "items",
        "runs",
        "config",
        "data",
        "actions"
      ],
      "toolActions": [
        "connector.status",
        "connector.stats",
        "connector.driverList",
        "connector.sourceList",
        "connector.sourceGet",
        "connector.sourceCreate",
        "connector.sourceUpdate",
        "connector.sourceDelete",
        "connector.sourceBind",
        "connector.sourceDelivery",
        "connector.sourceRun",
        "connector.itemList",
        "connector.runList",
        "connector.dataTables",
        "connector.dataQuery",
        "connector.actionSchema"
      ],
      "client": "lib/client.js"
    }
  },
  "dependencies": {
    "dsh-workbench-host": "^0.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-workbench-host"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "author": "ityyq777",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "connector",
    "rss",
    "webhook",
    "feed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ityyq777/dsh-workbench.git",
    "directory": "packages/connector"
  },
  "homepage": "https://github.com/ityyq777/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ityyq777/dsh-workbench/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
